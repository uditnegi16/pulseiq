# --- secrets (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
.secrets/

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- testing / tooling ---
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.ruff_cache/
.mypy_cache/

# --- ml artifacts ---
mlruns/
mlartifacts/
models/*
!models/.gitkeep
*.pt
*.bin
*.safetensors

# --- data (keep folders, ignore contents) ---
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/**/.gitkeep

# --- reports ---
reports/drift/*
reports/figures/*
!reports/**/.gitkeep

# --- local db ---
*.db
*.sqlite
*.sqlite3

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
*.log

# --- notebooks ---
.ipynb_checkpoints/
mlflow.db
mlartifacts/
# Reports are regenerated on every run, so they are ignored by default.
# The three below are the CI regression gate's reference values -- they must be
# committed, or the gate has nothing to compare a new run against.
reports/*.csv
reports/*.json
!reports/sentiment_baseline.json
!reports/sentiment_finetuned.json
!reports/horizon_curve.csv

# Fine-tuned LoRA adapter - small enough to commit, and
# committing it is what makes the result reproducible.
!models/sentiment_lora/
!models/sentiment_lora/**
