# ---------------------------------------------------------------------------
# Copy to .env and fill with REAL values.  .env is gitignored - never commit it.
#   Copy-Item .env.example .env
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- LLM providers ---------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=

# --- Notifications ---------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- MongoDB Atlas (raw scraped docs) --------------------------------------
MONGODB_URI=
MONGODB_DB=pulseiq
MONGODB_RAW_COLLECTION=raw_scrapes

# --- Relational store (cleaned data) ---------------------------------------
DATABASE_URL=sqlite:///./pulseiq.db

# --- Redis / Upstash cache -------------------------------------------------
REDIS_URL=
CACHE_TTL_SECONDS=3600

# --- MLflow ----------------------------------------------------------------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=pulseiq

# --- Scraper ---------------------------------------------------------------
SCRAPE_HEADLESS=true
SCRAPE_MAX_RETRIES=3
SCRAPE_BACKOFF_SECONDS=2
SCRAPE_DELAY_SECONDS=5
SCRAPE_USER_AGENT=Mozilla/5.0 (compatible; PulseIQResearchBot/0.1)

# --- API / frontend --------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
